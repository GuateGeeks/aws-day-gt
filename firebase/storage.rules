rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function staff() { return signedIn() && (request.auth.token.role == 'moderator' || request.auth.token.role == 'admin'); }

    match /evidence/{eventId}/{uid}/{challengeId}/{fileName} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && challengeId in ['C15', 'C16', 'C17']
        && request.resource.size <= 1572864
        && request.resource.contentType.matches('image/(webp|jpeg|png)');
      allow read: if signedIn() && challengeId in ['C15', 'C16', 'C17'] && (request.auth.uid == uid || staff());
      allow update, delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
