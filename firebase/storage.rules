rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function ownerAdmin() { return signedIn() && request.auth.token.role == 'admin' && request.auth.token.email == 'guategeeks3d@gmail.com'; }

    match /evidence/{eventId}/{uid}/{challengeId}/{fileName} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && challengeId in ['C15', 'C16', 'C17']
        && request.time < timestamp.value(1791669600000)
        && request.resource.size <= 1572864
        && request.resource.contentType.matches('image/(webp|jpeg|png)');
      allow read: if signedIn() && challengeId in ['C15', 'C16', 'C17'] && (request.auth.uid == uid || ownerAdmin());
      allow update, delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
