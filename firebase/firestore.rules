rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function role() { return signedIn() && request.auth.token.role != null ? request.auth.token.role : 'participant'; }
    function staff() { return role() == 'moderator' || role() == 'admin'; }
    function admin() { return role() == 'admin'; }

    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
      match /schedule/{sessionId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /users/{uid} {
      allow read: if owns(uid) || staff();
      allow create: if false;
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interests', 'consent', 'lastLoginAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    match /missions/{missionId} {
      allow read: if signedIn() && (resource.data.active == true || staff());
      allow write: if false;
    }

    match /missionAnswerKeys/{missionId} {
      allow read, write: if false;
    }

    match /userMissions/{assignmentId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || staff());
      allow write: if false;
    }

    match /submissions/{submissionId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || staff());
      allow write: if false;
    }

    match /scores/{scoreId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /config/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.audience == 'all');
      allow write: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if admin();
      allow write: if false;
    }

    match /deletionRequests/{uid} {
      allow read: if owns(uid) || admin();
      allow write: if false;
    }

    match /aliases/{alias} { allow read, write: if false; }
    match /idempotency/{operationId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
